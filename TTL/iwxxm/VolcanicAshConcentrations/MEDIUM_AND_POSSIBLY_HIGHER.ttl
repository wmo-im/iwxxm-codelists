@prefix dct: <http://purl.org/dc/terms/> .
@prefix ldp: <http://www.w3.org/ns/ldp#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://codes.wmo.int/iwxxm/VolcanicAshConcentrations/MEDIUM_AND_POSSIBLY_HIGHER> a reg:Register,
        skos:Collection,
        ldp:Container ;
    dct:description "Greater than or equal to 2 mg/m3 - Medium and possibly higher"@en ;
    skos:notation "MEDIUM_AND_POSSIBLY_HIGHER" .

