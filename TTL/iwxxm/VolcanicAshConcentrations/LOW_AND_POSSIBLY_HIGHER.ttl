@prefix dct: <http://purl.org/dc/terms/> .
@prefix ldp: <http://www.w3.org/ns/ldp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://codes.wmo.int/iwxxm/VolcanicAshConcentrations/LOW_AND_POSSIBLY_HIGHER> a reg:Register,
        skos:Collection,
        ldp:Container ;
    rdfs:label "Greater than or equal to 0.2 mg/m3 - Low and possibly higher"@en ;
    dct:description "Greater than or equal to 0.2 mg/m3 - Low and possibly higher"@en ;
    skos:notation "LOW_AND_POSSIBLY_HIGHER" .

