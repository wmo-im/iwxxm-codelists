@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<RED> a skos:Concept ;
    rdfs:label "Red"@en ;
    dcterms:description "Eruption is forecasted to be imminent with significant emission of ash into the atmosphere likely. Or, eruption is underway with significant emission of ash into the atmosphere [specify ash-plume height if possible]."@en ;
    owl:versionInfo <http://icao.int/iwxxm/2025-2> ;
    skos:notation "RED" .

