@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://codes.wmo.int/common/nil/withheld> a reg:Register,
        skos:Collection,
        ldp:Container ;
    rdfs:label "Withheld"@en ;
    dc:source "ISO 19136:2007 Geographic information - Geography Markup Language sub-clause 8.2.3.1"@en ;
    dct:description "The value is not divulged."@en ;
    reg:status "stable" ;
    rdfs:seeAlso <http://www.opengis.net/doc/gml#clause-8.2.3.1> ;
    owl:versionInfo <http://icao.int/iwxxm/1.1>,
        <http://icao.int/iwxxm/2.1>,
        <http://icao.int/iwxxm/2021-2>,
        <http://icao.int/iwxxm/2023-1>,
        <http://icao.int/iwxxm/2025-2>,
        <http://icao.int/iwxxm/3.0> ;
    skos:notation "withheld" .

