@prefix dct: <http://purl.org/dc/terms/> .
@prefix ldp: <http://www.w3.org/ns/ldp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://codes.wmo.int/49-2/SpaceWxLocation> a reg:Register,
        skos:Collection,
        ldp:Container ;
    rdfs:label "Space Wx Location"@en ;
    dct:description "The items within this code table are the locations of space weather phenomena of significance to aeronautical operations"@en ;
    reg:status "stable" ;
    skos:notation "SpaceWxLocation" .

