@prefix dct: <http://purl.org/dc/terms/> .
@prefix ldp: <http://www.w3.org/ns/ldp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://codes.wmo.int/49-2/MeteorologicalFeature> a reg:Register,
        skos:Collection,
        ldp:Container ;
    rdfs:label "Meteorological Features"@en ;
    dct:description "The items within this code table are the weather phenomena being represented by a weather object"@en ;
    owl:versionInfo <http://icao.int/iwxxm/2021-2>,
        <http://icao.int/iwxxm/2023-1> ;
    skos:notation "MeteorologicalFeature" .

