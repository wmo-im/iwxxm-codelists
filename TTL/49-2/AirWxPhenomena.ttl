@prefix dct: <http://purl.org/dc/terms/> .
@prefix ldp: <http://www.w3.org/ns/ldp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<AirWxPhenomena> a reg:Register,
        skos:Collection,
        ldp:Container ;
    rdfs:label "Air Wx Phenomena"@en ;
    dct:description "The items within this code table are the weather phenomena to be included in a SIGMET message as defind in ICAO Annex 3 and PANS-MET"@en ;
    owl:versionInfo <http://icao.int/iwxxm/2.1>,
        <http://icao.int/iwxxm/2021-2>,
        <http://icao.int/iwxxm/2023-1>,
        <http://icao.int/iwxxm/2025-2>,
        <http://icao.int/iwxxm/3.0> ;
    skos:notation "AirWxPhenomena" ;
    ldp:hasMemberRelation skos:member .

