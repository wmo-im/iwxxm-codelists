@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<EQN> a skos:Concept ;
    rdfs:label "Equatorial latitudes northern hemisphere"@en ;
    dcterms:description "Equatorial latitudes northern hemisphere (30 degrees N – 0 degrees N)"@en ;
    owl:versionInfo <http://icao.int/iwxxm/2021-2>,
        <http://icao.int/iwxxm/2023-1>,
        <http://icao.int/iwxxm/2025-2>,
        <http://icao.int/iwxxm/3.0> ;
    skos:notation "EQN" .

