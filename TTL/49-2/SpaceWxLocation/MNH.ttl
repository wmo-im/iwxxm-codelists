@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<MNH> a skos:Concept ;
    rdfs:label "Middle latitudes northern hemisphere"@en ;
    dcterms:description "Middle latitudes northern hemisphere (60 degrees N – 30 degrees N)"@en ;
    owl:versionInfo <http://icao.int/iwxxm/2021-2>,
        <http://icao.int/iwxxm/2023-1>,
        <http://icao.int/iwxxm/2025-2>,
        <http://icao.int/iwxxm/3.0> ;
    skos:notation "MNH" .

