<http://codes.wmo.int/49-2/CloudAmountReportedAtAerodrome> a reg:Register,
        skos:Collection,
        ldp:Container ;
    rdfs:label "Code Table D-8: Cloud amount reported at aerodrome"@en ;
    dct:description "The items within this code table are the cloud amount categories of operational significance for aviation as specified in ICAO Annex 3 and PANS-MET. This code table contains a subset of the cloud amount categories defined in the Manual on Codes (WMO No.306), Vol. I.2 Part B FM 94 BUFR Code table 0 20 008."@en ;
    owl:versionInfo <http://icao.int/iwxxm/1.1>,
        <http://icao.int/iwxxm/2.1>,
        <http://icao.int/iwxxm/2021-2>,
        <http://icao.int/iwxxm/2023-1>,
        <http://icao.int/iwxxm/2025-2>,
        <http://icao.int/iwxxm/3.0> ;
    skos:notation "CloudAmountReportedAtAerodrome" .

